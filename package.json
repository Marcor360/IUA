{
  "name": "iua-home-landing-react-secure",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "build": "npm run generate:sitemap && npm run validate:data && vite build && npm run prerender && npm run validate:seo",
    "prerender": "node scripts/prerender.mjs",
    "validate:seo": "node scripts/validate-seo-build.mjs",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "serve:e2e": "node scripts/serve-dist.mjs",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "audit": "npm audit --audit-level=high",
    "safe-install": "npm install --ignore-scripts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
